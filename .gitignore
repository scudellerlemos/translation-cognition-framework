# Binários de jogo (assets com copyright) — nunca versionar
# O usuário entrega o .sdat localmente (artifacts/ ou via CLI); ver project.json.
*.sdat

# Artefatos de build do Python
__pycache__/
*.pyc
build/
*.egg-info/

# Ambientes virtuais (ex.: .venv com a stack de ML opcional — requirements-ml.txt)
.venv/
venv/
.coverage

# Banco SQLite gerado por migrate_from_flat.py (fonte de verdade é regenerável dos flat files)
*.db
*.db-wal
*.db-shm

# Segredos — chave de API NUNCA versionada (use .env local; ver .env.example, esse SIM versionado)
.env
.env.local

# Regeneráveis 100% determinísticos do context_pack (saída de artifacts/<cena>/).
# São reconstruídos a cada run; não são entregável nem estado durável → não versionar
# (também elimina o churn de regeneração ao rodar os testes). Ver docs/NAMING.md.
projects/*/artifacts/**/pack.json
projects/*/artifacts/**/scene_prompt.md
projects/*/artifacts/**/back_prompt_*.md

# Texto do roteiro do jogo extraído em massa (dado comercial de terceiros, risco de direito
# autoral em repo público — mantido só localmente, ver ADR de purga do histórico).
projects/*/artifacts/**/dialogs.csv
projects/*/artifacts/**/translations_*.json
projects/*/artifacts/**/translation_plan*.json
projects/*/artifacts/**/approved_*.csv
projects/*/artifacts/**/back_translation_*.json
projects/*/artifacts/**/translation_memory.jsonl
projects/*/artifacts/glossary_lint.json
projects/*/artifacts/hitl_state.json
projects/*/artifacts/evidence/

# Exceção: projects/demo é sintético (dialogo ficticio, sem copyright) — precisa estar
# versionado pra README prometer "clone e rode" de verdade. Traduções/plan/approved
# do demo continuam ignorados (regeneráveis, mesmo padrão dos projetos reais).
!projects/demo/artifacts/**/dialogs.csv

# Saída do conector (binários remontados com copyright — nunca versionar)
projects/*/output/
projects/*/backup_original/
projects/*/artifacts/qa_revisao/test_ingame/

# Pastas de teste manual no jogo (fixtures .pac reconstruídos pra validação visual — nunca versionar)
projects/*/manual_tests/

# Arquivos de revisão devolvidos pelo humano (dados pessoais / fluxo local)
projects/*/artifacts/qa_revisao/devolvido/

# Config local do Claude Code (pessoal/runtime) — settings.json/hooks/agents SÃO versionados
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/worktrees/
# texto bruto de fontes de KB (manual, wiki) — refaz com kb_fetch; proveniencia fica no research_log.md
projects/*/artifacts/research_cache/

# Cópia intocada dos DAT originais do jogo (fonte do extract/reinsert/verify — copyright, nunca versionar)
projects/*/source_dat/
projects/*/artifacts/qa_revisao/para_revisar/
projects/*/artifacts/scenes/*/_build_translations.py
projects/*/artifacts/scenes/*/_*.py
projects/utawarerumono/artifacts/archive/interjection_*.csv
projects/*/artifacts/kb_phase_worklist_*.md
projects/*/artifacts/historico_melhorias.md
projects/*/artifacts/plano_melhorias.md
projects/*/artifacts/auditoria_arquitetura.md
# escopo do piloto: a coluna de evidencia descreve o conteudo das cenas
projects/*/artifacts/pilot_scope.csv
projects/*/artifacts/scenes/*/bench_*.json

# Guardrail de conteudo (espelha .claude/hooks/content_guard.py, que a CI roda): nada de binario
# de jogo, imagem/print, planilha, nota local nem ferramenta de RE entra no repo, em pasta nenhuma.
*.dat
*.DAT
*.pak
*.pac
*.bin
*.BIN
*.exe
*.dll
*.uasset
*.win
*.xp3
*.arc
*.iso
*.bak
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.webp
*.mp4
*.xlsx
*.xls
*.ods
*.zip
*.7z
*.rar
*.gpr
*.rep/
*.i64
*.idb
*.local.md
review_*.csv

# Prints do teste in-game (telas do jogo, pesados) — ficam locais; o relato_tester.csv e versionado
projects/*/artifacts/qa_revisao/teste_ingame/prints/*
!projects/*/artifacts/qa_revisao/teste_ingame/prints/.gitkeep
# Diagnostico do verify por cena (regeneravel, mesmo padrao de plan/approved)
projects/*/artifacts/**/verify_diagnostics_*.json
# Log estruturado de eventos (regeneravel; mensagem de excecao pode citar conteudo).
projects/*/artifacts/events.jsonl
projects/*/artifacts/alerts.jsonl
projects/*/artifacts/wave_last*.log
# Travas e temporarios da gravacao de estado (ADR 0018): transitorios, nunca versionar
projects/*/artifacts/**/*.lock
projects/*/artifacts/**/*.tmp

# ferramentas locais de sessao (instalacao no jogo, lotes): fora do repo, sobrevivem ao /clear
projects/*/tools_local/

# memoria de traducao entre jogos da serie: roteiro + traducao, nunca versionar
tm/
# registro de decisao humana e marcas de fase: locais ate o guard da main liberar
projects/*/artifacts/hitl_log.jsonl
projects/*/artifacts/phase_marks.jsonl

# Pacote do patcher (deltas + manifest + exe): vai para a Release, nunca para o repo
projects/*/dist/

# utawarerumono_prelude: medicao local de custo e notas de onda (citam cenas/termos do jogo)
projects/utawarerumono_prelude/artifacts/baseline_gaps_custo_pre_onda1.txt
projects/utawarerumono_prelude/artifacts/historico_retomada.md
projects/utawarerumono_prelude/artifacts/ordem_cenas.txt
projects/utawarerumono_prelude/artifacts/panorama_ondas.md
projects/utawarerumono_prelude/artifacts/pendencias_finais.md

# rascunho de subagente
scratch/

.claude/skills/rodar-onda/logs/
