    {
      "offset": "STR_INGAME_DIALOGS_AP_CROMAMINION_1_1",
      "text_source": "I see that the commander has brought you the orb.",
      "speaker": "Balof",
      "tone_register": "coloquial informal hiperbólico",
      "intent": "observação entusiasmada de situação",
      "risk_level": "low",
      "base_translation": "Vejo que o comandante trouxe o orbe pra você!",
      "byte_budget": 49,
      "glossary_flags": [],
      "spoiler_flags": [],
      "risk_notes": ""
    },
    {
      "offset": "STR_INGAME_DIALOGS_AP_CROMAMINION_1_2",
      "text_source": "You can learn a lot from observing. We know we could count on you, little man.",
      "speaker": "Balof",
      "tone_register": "coloquial informal hiperbólico",
      "intent": "elogio exagerado e confiança desmedida",
      "risk_level": "medium",
      "base_translation": "Dá pra aprender muito só observando! A gente sabia que podia contar com você, meu miúdo!",
      "byte_budget": 78,
      "glossary_flags": [],
      "spoiler_flags": [],
      "risk_notes": "'little man' preserva dimensão física do PJ; sem redundância em pt-BR; ritmo de hipérbole mantido"
    },
    {
      "offset": "STR_INGAME_DIALOGS_AP_CROMAMINION_2_1",
      "text_source": "You must know someone in the city who is capable of doing it.",
      "speaker": "Brigard",
      "tone_register": "formal-military seco",
      "intent": "suposição sutil/pressão indireta",
      "risk_level": "low",
      "base_translation": "Você deve conhecer alguém na cidade capaz de fazer isso.",
      "byte_budget": 61,
      "glossary_flags": [],
      "spoiler_flags": [],
      "risk_notes": ""
    },
    {
      "offset": "STR_INGAME_DIALOGS_AP_CROMAMINION_2_2",
      "text_source": "We are not particularly... adept... at dealing with small people.",
      "speaker": "Brigard",
      "tone_register": "formal-military seco",
      "intent": "admissão constrangida de limitação física",
      "risk_level": "medium",
      "base_translation": "Não somos particularmente... aptos... em lidar com pessoas miúdas.",
      "byte_budget": 65,
      "glossary_flags": [],
      "spoiler_flags": [],
      "risk_notes": "'small people' refere-se a limitação física literal; manter distância formal de Brigard; não humanizar com coloquialismo"
    },
    {
      "offset": "STR_INGAME_DIALOGS_AP_CROMAMINION_3_1",
      "text_source": "The Commander made great efforts in asking you for help, don't think it was easy for him.",
      "speaker": "Brigard",
      "tone_register": "formal-military seco",
      "intent": "reconhecimento de sacrifício alheio; encorajamento sutil",
      "risk_level": "medium",
      "base_translation": "O Comandante se esforçou muito ao pedir sua ajuda. Não pense que foi fácil pra ele.",
      "byte_budget": 89,
      "glossary_flags": [],
      "spoiler_flags": [],
      "risk_notes": "Frases curtas, sem floreios; 'Commander' preserva formalidade militar; reconhecer esforço sem sentimentalismo"
    },
    {
      "offset": "STR_INGAME_DIALOGS_MAF_CROMAMINION_2_1",
      "text_source": "Do not worry, I will protect the beacon. The last thing we need is more intruders getting inside.",
      "speaker": "Brigard",
      "tone_register": "formal-military seco",
      "intent": "reafirmação de responsabilidade; vigilância",
      "risk_level": "low",
      "base_translation": "Não se preocupe, vou proteger o farol. A última coisa que precisamos é mais intrusos entrando.",
      "byte_budget": 97,
      "glossary_flags": [],
      "spoiler_flags": [],
      "risk_notes": ""
    },
    {
      "offset": "STR_INGAME_DIALOGS_AAF_CROMAMINION_1_1",
