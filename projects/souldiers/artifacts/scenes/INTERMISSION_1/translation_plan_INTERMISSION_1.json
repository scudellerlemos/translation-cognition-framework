    {
      "offset": "STR_DIALOGS_INTERMISSION_1_D2_LIANDRIS_1",
      "text_source": "I am here, my lady.",
      "speaker": "unknown",
      "tone_register": "formal-military",
      "intent": "acknowledgment",
      "risk_level": "low",
      "base_translation": "Aqui estou, minha senhora.",
