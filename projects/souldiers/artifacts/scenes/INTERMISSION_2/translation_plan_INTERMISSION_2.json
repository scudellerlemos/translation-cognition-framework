      "risk_notes": ""
    },
    {
      "offset": "STR_DIALOGS_INTERMISSION_2_D1_FREYDIN_2",
      "text_source": "Liandris... answer my call.",
      "speaker": "unknown",
      "tone_register": "formal-solemn",
      "intent": "command-plea",
      "risk_level": "low",
      "base_translation": "Liandris... responda meu chamado.",
      "byte_budget": 27,
      "glossary_flags": [],
      "spoiler_flags": [],
      "risk_notes": ""
    },
    {
      "offset": "STR_DIALOGS_INTERMISSION_2_D2_LIANDRIS_1",
      "text_source": "I am here, my lady.",
      "speaker": "unknown",
      "tone_register": "formal-solemn",
      "intent": "obedience",
      "risk_level": "low",
      "base_translation": "Estou aqui, minha dama.",
      "byte_budget": 19,
      "glossary_flags": [],
      "spoiler_flags": [],
      "risk_notes": ""
    },
    {
      "offset": "STR_DIALOGS_INTERMISSION_2_D2_FREYDIN_2",
      "text_source": "Liandris, those Humans I was made aware of... I must know the circumstances of their arrival on Terragaya.",
      "speaker": "unknown",
      "tone_register": "formal-solemn",
      "intent": "interrogation-urgent",
      "risk_level": "medium",
      "base_translation": "Liandris, aqueles Humanos de que fui informada... preciso saber as circunstâncias de sua chegada em Terragaya.",
      "byte_budget": 106,
      "glossary_flags": [],
      "spoiler_flags": [],
      "risk_notes": "Lore integration (Terragaya arrival context); formal register must preserve military precision."
    },
    {
      "offset": "STR_DIALOGS_INTERMISSION_2_D2_LIANDRIS_3",
      "text_source": "They were preparing for war.",
      "speaker": "unknown",
      "tone_register": "formal-solemn",
      "intent": "statement-factual",
      "risk_level": "low",
      "base_translation": "Preparavam-se para guerra.",
      "byte_budget": 28,
      "glossary_flags": [],
      "spoiler_flags": [],
      "risk_notes": ""
    },
    {
      "offset": "STR_DIALOGS_INTERMISSION_2_D2_FREYDIN_4",
      "text_source": "Preparing? They did not die in combat?",
      "speaker": "unknown",
      "tone_register": "formal-solemn",
      "intent": "interrogation-clarification",
      "risk_level": "low",
      "base_translation": "Preparavam-se? Não morreram em combate?",
      "byte_budget": 38,
      "glossary_flags": [],
      "spoiler_flags": [],
      "risk_notes": ""
    },
    {
      "offset": "STR_DIALOGS_INTERMISSION_2_D2_LIANDRIS_5",
      "text_source": "No, but we were called to their location, a place where they found themselves sealed off and isolated, not just from their own world, but from the universe",
      "speaker": "unknown",
      "tone_register": "formal-solemn",
      "intent": "statement-exposition",
      "risk_level": "medium",
      "base_translation": "Não, mas fomos chamados ao local deles, um lugar onde se viram isolados e cercados, não apenas de seu próprio mundo, mas do universo.",
      "byte_budget": 155,
      "glossary_flags": [],
      "spoiler_flags": [],
      "risk_notes": "Complex lore exposition (sealed location, cosmic isolation); maintain formal register; byte budget allows full explanation."
    },
    {
      "offset": "STR_DIALOGS_INTERMISSION_2_D2_FREYDIN_6",
      "text_source": "And they arrived not long after those beings began to appear on the planet's surface...",
      "speaker": "unknown",
      "tone_register": "formal-solemn",
      "intent": "statement-observation",
      "risk_level": "medium",
      "base_translation": "E chegaram pouco após aquelas criaturas começarem a aparecer na superfície do planeta...",
      "byte_budget": 87,
      "glossary_flags": [],
      "spoiler_flags": [],
      "risk_notes": "Temporal connection (arrival timing linked to emergence of entities); maintain formality; no spoiler implication."
    },
    {
      "offset": "STR_DIALOGS_INTERMISSION_2_D2_LIANDRIS_7",
      "text_source": "Is something the matter, my lady?",
      "speaker": "unknown",
      "tone_register": "formal-solemn",
      "intent": "polite-inquiry",
      "risk_level": "low",
      "base_translation": "Há algo que a preocupe, minha dama?",
      "byte_budget": 33,
      "glossary_flags": [],
      "spoiler_flags": [],
      "risk_notes": ""
    },
    {
      "offset": "STR_DIALOGS_INTERMISSION_2_D2_FREYDIN_8",
      "text_source": "Nothing deserving of my time or energy at this moment. Keep your distance from them and visit Terragaya only when strictly necessary.",
      "speaker": "unknown",
      "tone_register": "formal-solemn",
      "intent": "dismissal-command",
      "risk_level": "low",
      "base_translation": "Nada que mereça meu tempo ou atenção neste momento. Mantenha distância deles e visite Terragaya apenas quando estritamente necessário.",
      "byte_budget": 133,
      "glossary_flags": [],
      "spoiler_flags": [],
      "risk_notes": ""
    },
    {
      "offset": "STR_DIALOGS_INTERMISSION_2_D2_FREYDIN_9",
      "text_source": "Inform the others.",
      "speaker": "unknown",
      "tone_register": "formal-solemn",
      "intent": "command",
      "risk_level": "low",
      "base_translation": "Informe os outros.",
      "byte_budget": 18,
      "glossary_flags": [],
      "spoiler_flags": [],
      "risk_notes": ""
    },
    {
      "offset": "STR_DIALOGS_INTERMISSION_2_D2_LIANDRIS_10",
      "text_source": "As you wish, my lady.",
      "speaker": "unknown",
      "tone_register": "formal-solemn",
      "intent": "obedience-confirmation",
      "risk_level": "low",
      "base_translation": "Como deseja, minha dama.",
      "byte_budget": 21,
