      "glossary_flags": [],
      "spoiler_flags": [],
      "risk_notes": "Identidade de Freydin/Valquíria em controle; relação hierárquica crucial; Valquíria como criatura controlável — spoiler potencial se revelação pendente. Back-translation obrigatória."
    },
    {
      "offset": "STR_DIALOGS_INTERMISSION_3_D2_LIANDRIS_3",
      "text_source": "I am sorr-",
      "speaker": "npc",
      "tone_register": "formal-militar",
