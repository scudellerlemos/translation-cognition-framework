      "spoiler_flags": [],
      "risk_notes": ""
    },
    {
      "offset": "STR_DIALOGS_INTERMISSION_3_D2_FREYDIN_4",
      "text_source": "Do not interrupt me, Liandris. You have humiliated me in front of the others.",
      "speaker": "unknown",
      "tone_register": "formal-solene",
      "intent": "repreensão cortante, silenciamento",
      "risk_level": "medium",
      "base_translation": "Não me interrompa, Liandris. Você me humilhou diante dos outros.",
      "byte_budget": 77,
      "glossary_flags": [],
      "spoiler_flags": [],
      "risk_notes": "Dinâmica de poder; humilhação pública mencionada — tensão emocional alta. Tom de corte seco e militar."
    },
    {
      "offset": "STR_DIALOGS_INTERMISSION_3_D2_LIANDRIS_5",
      "text_source": "Is there something I can do?",
      "speaker": "npc",
      "tone_register": "formal-militar",
      "intent": "oferta de reparação submissa",
      "risk_level": "low",
      "base_translation": "Há algo que eu possa fazer?",
      "byte_budget": 28,
      "glossary_flags": [],
      "spoiler_flags": [],
      "risk_notes": ""
    },
    {
      "offset": "STR_DIALOGS_INTERMISSION_3_D2_FREYDIN_6",
      "text_source": "You have done quite enough.",
      "speaker": "unknown",
      "tone_register": "formal-solene",
      "intent": "rejeição definitiva",
