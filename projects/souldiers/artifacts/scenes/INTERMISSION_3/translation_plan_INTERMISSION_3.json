      "glossary_flags": [],
      "spoiler_flags": [],
      "risk_notes": ""
    },
    {
      "offset": "STR_DIALOGS_INTERMISSION_3_D2_LIANDRIS_7",
      "text_source": "I can be erased if that is to be my punishment.",
      "speaker": "npc",
      "tone_register": "formal-militar",
      "intent": "oferta de autossacrifício",
      "risk_level": "medium",
      "base_translation": "Posso ser apagada se esse for meu castigo.",
