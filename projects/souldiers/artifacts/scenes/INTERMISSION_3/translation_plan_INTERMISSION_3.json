    {
      "offset": "STR_DIALOGS_INTERMISSION_3_D2_FREYDIN_8",
      "text_source": "What good would that do?",
      "speaker": "unknown",
      "tone_register": "formal-solene",
      "intent": "pergunta retórica, rejeição",
      "risk_level": "low",
      "base_translation": "Que bem isso faria?",
      "byte_budget": 24,
