      "base_translation": "...",
      "byte_budget": 3,
      "glossary_flags": [],
      "spoiler_flags": [],
      "risk_notes": ""
    },
    {
      "offset": "STR_DIALOGS_PLAINS3_AP2_D2_FINSE_2",
      "text_source": "Hafin City's insignia...",
      "speaker": "Jivan",
      "tone_register": "formal-misterioso assertivo",
      "intent": "reconhecimento de símbolo",
      "risk_level": "medium",
      "base_translation": "O brasão de Hafin City...",
      "byte_budget": 24,
      "glossary_flags": [],
      "spoiler_flags": [],
      "risk_notes": "'Insignia de Hafin City' é potencial revelação de contexto político/lore; manter formalidade de Jivan sem floreios"
    },
    {
      "offset": "STR_DIALOGS_PLAINS3_AP2_D2_FINSE_3",
      "text_source": "So soon...",
      "speaker": "Jivan",
      "tone_register": "formal-misterioso assertivo",
      "intent": "surpresa controlada",
      "risk_level": "low",
      "base_translation": "Tão cedo...",
      "byte_budget": 10,
      "glossary_flags": [],
      "spoiler_flags": [],
      "risk_notes": ""
    },
    {
      "offset": "STR_DIALOGS_PLAINS3_AP2_D2_FINSE_4",
      "text_source": "Mister Jivan told me this could happen one day.",
      "speaker": "Jivan",
      "tone_register": "formal-misterioso assertivo",
      "intent": "confirmação de previsão",
      "risk_level": "low",
      "base_translation": "Jivan me disse que isso poderia acontecer um dia.",
      "byte_budget": 47,
      "glossary_flags": [],
      "spoiler_flags": [],
      "risk_notes": ""
    },
    {
      "offset": "STR_DIALOGS_PLAINS3_AP2_D2_FINSE_5",
      "text_source": "Proceed, I understand that circumstances require it.",
      "speaker": "Jivan",
      "tone_register": "formal-misterioso assertivo",
      "intent": "aceitação resignada",
      "risk_level": "low",
      "base_translation": "Prossiga. Compreendo que as circunstâncias o exigem.",
      "byte_budget": 52,
      "glossary_flags": [],
      "spoiler_flags": [],
      "risk_notes": ""
    },
    {
      "offset": "STR_DIALOGS_PLAINS3_AP2_D2_FINSE_6",
      "text_source": "The flower you're looking for is right here. I've been keeping her alive for you.",
      "speaker": "Jivan",
      "tone_register": "formal-misterioso assertivo",
      "intent": "revelação e custódia",
      "risk_level": "medium",
      "base_translation": "A flor que procura está aqui. Mantive-a viva para você.",
      "byte_budget": 81,
      "glossary_flags": [],
      "spoiler_flags": [],
      "risk_notes": "'a flor' é metáfora de lore; manter registro formal, assertivo, sem exploração do sentimentalismo"
    },
    {
      "offset": "STR_DIALOGS_PLAINS3_AP2_D2_FINSE_7",
      "text_source": "Please remove her extremely delicately and, above all, acknowledge her sacrifice with respect.",
      "speaker": "Jivan",
      "tone_register": "formal-misterioso assertivo",
      "intent": "instrução solene e respeitosa",
      "risk_level": "low",
      "base_translation": "Por favor, remova-a com extrema delicadeza e, acima de tudo, reconheça seu sacrifício com respeito.",
      "byte_budget": 94,
      "glossary_flags": [],
      "spoiler_flags": [],
      "risk_notes": ""
    },
    {
      "offset": "STR_DIALOGS_PLAINS3_AP2_D3_FINSE_1",
      "text_source": "She is yours.",
      "speaker": "Jivan",
      "tone_register": "formal-misterioso assertivo",
      "intent": "transferência de posse",
      "risk_level": "low",
      "base_translation": "Ela é sua.",
      "byte_budget": 13,
      "glossary_flags": [],
      "spoiler_flags": [],
      "risk_notes": ""
    },
    {
      "offset": "STR_DIALOGS_PLAINS3_AP2_D3_FINSE_2",
      "text_source": "Take her to mister Jivan and tell him that, should he need anything, I'll be here.",
      "speaker": "Jivan",
      "tone_register": "formal-misterioso assertivo",
      "intent": "instrução final com oferta de apoio",
      "risk_level": "low",
      "base_translation": "Leve-a a Jivan e diga-lhe que, caso precise de algo, estarei aqui.",
      "byte_budget": 82,
      "glossary_flags": [],
      "spoiler_flags": [],
      "risk_notes": ""
    },
    {
      "offset": "STR_DIALOGS_PLAINS3_AP2_D3_FINSE_3",
      "text_source": "Don't worry, it'll be alright.",
      "speaker": "Jivan",
      "tone_register": "formal-misterioso assertivo",
      "intent": "tranquilização solidária",
      "risk_level": "low",
      "base_translation": "Não se preocupe, ficará bem.",
      "byte_budget": 30,
