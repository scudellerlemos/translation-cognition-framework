  "lines": [
    {
      "offset": "STR_DIALOGS_PLAINS3_AP2_D1_FINSE_1",
      "text_source": "In this place, we are the guests. I'm simply responsible for preserving our hosts.",
      "speaker": "Jivan",
      "tone_register": "formal-misterioso assertivo",
      "intent": "estabelecer autoridade e responsabilidade pelo local",
      "risk_level": "low",
      "base_translation": "Neste lugar, somos os convidados. Simplesmente sou responsável por preservar nossos anfitriões.",
      "byte_budget": 82,
      "glossary_flags": [],
      "spoiler_flags": [],
      "risk_notes": ""
    },
    {
      "offset": "STR_DIALOGS_PLAINS3_AP2_D1_FINSE_2",
      "text_source": "May I help you with something?",
      "speaker": "Jivan",
      "tone_register": "formal-misterioso assertivo",
      "intent": "oferecer ajuda cortesmente",
      "risk_level": "low",
      "base_translation": "Posso ajudá-lo em algo?",
      "byte_budget": 30,
      "glossary_flags": [],
      "spoiler_flags": [],
      "risk_notes": ""
    },
    {
      "offset": "STR_DIALOGS_PLAINS3_AP2_D2_FINSE_1",
