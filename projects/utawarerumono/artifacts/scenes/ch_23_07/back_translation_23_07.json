      "offset": "0x28e8b7",
      "back_en": "perspectives.",
      "verdict": "pass",
      "note": "Ok."
    },
    {
      "offset": "0x28e8c5",
      "back_en": "...Don't you agree?",
      "verdict": "pass",
      "note": "Fiel."
    },
