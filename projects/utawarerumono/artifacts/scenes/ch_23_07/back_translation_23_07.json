      "verdict": "pass",
      "note": "Fiel."
    },
    {
      "offset": "0x28d626",
      "back_en": "punishment.",
      "verdict": "pass",
      "note": "Ok."
    },
    {
      "offset": "0x28d657",
      "back_en": "vengeance...",
      "verdict": "pass",
      "note": "Ok."
    },
    {
      "offset": "0x28d7fd",
      "back_en": "will never see you in your... bridal...",
      "verdict": "pass",
