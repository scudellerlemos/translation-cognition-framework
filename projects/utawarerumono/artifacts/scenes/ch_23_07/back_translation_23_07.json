      "offset": "0x28d8f1",
      "back_en": "happiness.\"",
      "verdict": "pass",
      "note": "Ok."
    },
    {
      "offset": "0x28e1ca",
      "back_en": "Please, come in.",
      "verdict": "pass",
      "note": "Fiel."
    },
    {
      "offset": "0x28e1e8",
      "back_en": "Ah, it really was you.",
      "verdict": "pass",
      "note": "Fiel."
    },
    {
      "offset": "0x28e2f2",
      "back_en": "of such praise...",
      "verdict": "pass",
      "note": "Ok."
    },
    {
      "offset": "0x28e304",
      "back_en": "And what could this be?",
      "verdict": "pass",
      "note": "'these' plural→'isto' singular, menor."
