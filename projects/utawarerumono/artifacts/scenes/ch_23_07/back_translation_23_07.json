      "back_en": "Papa.",
      "verdict": "pass",
      "note": "Ok."
    },
    {
      "offset": "0x288006",
      "back_en": "P-Papa...?",
      "verdict": "pass",
      "note": "Ok."
    },
    {
      "offset": "0x28834b",
      "back_en": "You're... the same as always, Papa.",
      "verdict": "pass",
      "note": "'igual ao sempre' um pouco torto, mas sentido mantido."
