    },
    {
      "offset": "0x28b6f8",
      "back_en": "Master, come here.",
      "verdict": "pass",
      "note": "Fiel."
    },
    {
      "offset": "0x28b76d",
      "back_en": "We'll prepare a bed soon.",
      "verdict": "pass",
      "note": "Fiel."
