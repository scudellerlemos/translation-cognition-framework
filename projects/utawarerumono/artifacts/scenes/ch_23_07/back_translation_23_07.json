    {
      "offset": "0x28e370",
      "back_en": "I see... sweets.",
      "verdict": "pass",
      "note": "Fiel."
    },
    {
      "offset": "0x28e43b",
      "back_en": "you mind leaving them there for now?",
      "verdict": "pass",
      "note": "Fiel."
    },
    {
      "offset": "0x28e52a",
      "back_en": "Well, well...",
      "verdict": "pass",
      "note": "Ok."
    },
    {
      "offset": "0x28e57f",
      "back_en": "Make sure of that.",
      "verdict": "revise",
      "note": "Voz mudou: 1ª pessoa 'I will be sure to do so' virou imperativo."
    },
    {
      "offset": "0x28e60e",
      "back_en": "I have to inform.",
      "verdict": "pass",
      "note": "Fragmento ok."
    },
    {
      "offset": "0x28e63a",
      "back_en": "There's still no official decision...",
      "verdict": "pass",
      "note": "Fiel."
    },
    {
      "offset": "0x28e6c2",
      "back_en": "caretaker.",
      "verdict": "pass",
      "note": "Ok."
    },
    {
      "offset": "0x28e746",
