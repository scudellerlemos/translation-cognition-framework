    },
    {
      "offset": "0x2ff23a",
      "back_en": "bring more casualties upon us!",
      "verdict": "pass",
      "note": "Equivalente."
    },
    {
      "offset": "0x2ffae0",
      "back_en": "YOU DAMNED WRETCH!!",
