{
  "entries": [
    {
      "offset": "0x31ae79",
      "back_en": "compares her face with the portrait, nodding.",
      "verdict": "pass",
      "note": "Accurate."
    },
    {
      "offset": "0x31aeae",
      "back_en": "It's her. One of Oshtor's subordinates.",
      "verdict": "pass",
      "note": "Accurate."
    },
    {
      "offset": "0x31afc6",
      "back_en": "kill her.",
      "verdict": "pass",
      "note": "Correct."
    },
    {
      "offset": "0x31b1cd",
      "back_en": "bursts into searing flames.",
      "verdict": "pass",
      "note": "Accurate."
    },
    {
      "offset": "0x31b534",
      "back_en": "the rest... yet she remains there.",
      "verdict": "pass",
      "note": "Accurate."
    },
    {
      "offset": "0x31b92c",
      "back_en": "K-Kill (them)! Kill that monster!!",
      "verdict": "pass",
      "note": "'it' rendered as plural imperative, acceptable."
    },
    {
      "offset": "0x31b991",
      "back_en": "Lucky, perhaps. However, they chose far too poorly.",
      "verdict": "pass",
      "note": "'demais' adds slight intensification but sense intact."
    },
    {
      "offset": "0x31bae9",
      "back_en": "It was you ......",
      "verdict": "pass",
      "note": "Tags preserved; ellipsis fine."
    },
    {
      "offset": "0x31bcc8",
      "back_en": "demon that brings calamity upon this world.",
      "verdict": "pass",
      "note": "Accurate."
    },
    {
      "offset": "0x31bd17",
      "back_en": "Nugwisomkami.",
      "verdict": "pass",
      "note": "Proper noun kept."
    },
    {
      "offset": "0x31bdd5",
      "back_en": "H...Help...",
      "verdict": "pass",
      "note": "Accurate."
    },
    {
      "offset": "0x31beae",
      "back_en": "It was you...",
      "verdict": "pass",
      "note": "Accurate."
    },
    {
      "offset": "0x31bfe5",
      "back_en": "running shadows, eyes devoid of emotion.",
      "verdict": "pass",
      "note": "Accurate."
    },
    {
      "offset": "0x31c00e",
      "back_en": "And then she stirs the air with her finger.",
      "verdict": "revise",
      "note": "'flicks' (peteleco/movimento brusco) weakened to 'mexe' (stirs)."
    },
    {
      "offset": "0x31c260",
      "back_en": "What was that...!?",
      "verdict": "pass",
      "note": "Accurate."
    },
    {
      "offset": "0x31c273",
      "back_en": "What the hell WAS that woman...!?",
      "verdict": "pass",
      "note": "Profanity softened to 'diabos' but tone preserved."
    },
    {
      "offset": "0x31c2ca",
      "back_en": "Impossible... impossible... impossible...",
      "verdict": "pass",
      "note": "Accurate."
    },
    {
      "offset": "0x31c2fc",
      "back_en": "Could that woman be...?",
      "verdict": "pass",
      "note": "Accurate."
    },
    {
      "offset": "0x31c314",
      "back_en": "I must report this... immediately...!",
      "verdict": "pass",
      "note": "Accurate."
    },
    {
      "offset": "0x31c33a",
      "back_en": "That woman...",
      "verdict": "pass",
      "note": "Accurate."
    },
    {
      "offset": "0x31c348",
      "back_en": "She has to be a--",
      "verdict": "pass",
      "note": "Accurate."
    },
    {
      "offset": "0x31c35a",
      "back_en": "She has to be a... what?",
      "verdict": "pass",
      "note": "Accurate."
    },
    {
      "offset": "0x31c37b",
      "back_en": "A voice from nowhere.",
      "verdict": "pass",
      "note": "Accurate."
    },
    {
      "offset": "0x31c3f9",
      "back_en": "That girl is our most precious little sister.",
      "verdict": "pass",
      "note": "'preciosíssima' superlative fine."
    },
    {
      "offset": "0x31c422",
      "back_en": "A very cute little sister.",
      "verdict": "pass",
      "note": "'cute'→'linda' acceptable."
    },
    {
      "offset": "0x31c43d",
      "back_en": "That's all she is.",
      "verdict": "pass",
      "note": "Accurate."
    },
    {
      "offset": "0x31c5b7",
      "back_en": "She will be eliminated.",
      "verdict": "pass",
      "note": "Accurate."
    },
    {
      "offset": "0x31c5cf",
      "back_en": "...You poor thing.",
      "verdict": "pass",
      "note": "Accurate."
    },
    {
      "offset": "0x31c5e2",
      "back_en": "You thought you escaped with your life.",
      "verdict": "pass",
      "note": "Accurate."
    },
    {
      "offset": "0x31c625",
      "back_en": "But now it's too late.",
      "verdict": "pass",
      "note": "'agora' added but harmless."
    },
    {
      "offset": "0x31c638",
      "back_en": "You were cruel to Ku.",
      "verdict": "pass",
      "note": "'mean'→'cruel' slightly stronger but fine."
    },
    {
      "offset": "0x31c9ce",
      "back_en": "Father... it hurts...",
      "verdict": "pass",
      "note": "Accurate."
    },
    {
      "offset": "0x31c9e4",
      "back_en": "It feels like... I cannot breathe...",
      "verdict": "pass",
      "note": "Accurate."
    },
    {
      "offset": "0x31ca09",
      "back_en": "I know that... it's something that can't be",
      "verdict": "pass",
      "note": "Accurate."
    },
    {
      "offset": "0x31ca41",
      "back_en": "I know there are those who never come back from the",
      "verdict": "pass",
      "note": "Meaning preserved."
    },
    {
      "offset": "0x31ca72",
      "back_en": "battle... I know that's part of war...",
      "verdict": "pass",
      "note": "'battlefield'→'batalha' minor."
    },
    {
      "offset": "0x31cac3",
      "back_en": "It feels like my heart is about to break...",
      "verdict": "pass",
      "note": "Accurate."
    },
    {
      "offset": "0x31caf6",
      "back_en": "I don't know what to do anymore...",
      "verdict": "pass",
      "note": "Slightly awkward word order but fine."
    },
    {
      "offset": "0x31cb39",
      "back_en": "I've... never felt anything like this...",
      "verdict": "pass",
      "note": "Accurate."
    },
    {
      "offset": "0x31cb69",
      "back_en": "He was just... a lazy bum at first...",
      "verdict": "pass",
      "note": "Accurate."
    },
    {
      "offset": "0x31cb8f",
      "back_en": "I thought he'd never survive if I didn't look after him",
      "verdict": "pass",
      "note": "Accurate sense."
    },
    {
      "offset": "0x31cbed",
      "back_en": "But... as I spent more time with him...",
      "verdict": "pass",
      "note": "Accurate."
    },
    {
      "offset": "0x31cc51",
      "back_en": "But... it's so painful...",
      "verdict": "pass",
      "note": "Accurate."
    },
    {
      "offset": "0x31cc6b",
      "back_en": "It hurts... It hurts... so much...",
      "verdict": "pass",
      "note": "Accurate."
    },
    {
      "offset": "0x31cc97",
      "back_en": "You... loved him, Kuon.",
      "verdict": "pass",
      "note": "Accurate."
    },
    {
      "offset": "0x31ccaf",
      "back_en": "I... loved...?",
      "verdict": "pass",
      "note": "Accurate."
    },
    {
      "offset": "0x31ccbe",
      "back_en": "Yes, that is it...",
      "verdict": "pass",
      "note": "Accurate."
    },
    {
      "offset": "0x31ccd1",
      "back_en": "That feeling... is love.",
      "verdict": "pass",
      "note": "Accurate."
    },
    {
      "offset": "0x31ccea",
      "back_en": "A love like your mother's...",
      "verdict": "pass",
      "note": "Accurate."
    },
    {
      "offset": "0x31cd09",
      "back_en": "Sweet, but painful...",
      "verdict": "pass",
      "note": "Accurate."
    },
    {
      "offset": "0x31cd1f",
      "back_en": "A love that never had a chance to bloom...",
      "verdict": "pass",
      "note": "Accurate."
    },
    {
      "offset": "0x31cd50",
      "back_en": "I... see now...",
      "verdict": "pass",
      "note": "Accurate."
    },
    {
      "offset": "0x31cd60",
      "back_en": "So... that was it...",
      "verdict": "pass",
      "note": "Accurate."
    },
    {
      "offset": "0x31cd75",
      "back_en": "I... loved... Haku...",
      "verdict": "pass",
      "note": "Accurate."
    },
    {
      "offset": "0x31cd8b",
      "back_en": "Why... Why...",
      "verdict": "pass",
      "note": "'did' dropped but flow intact."
    },
    {
      "offset": "0x31cd9d",
      "back_en": "Why didn't... I realize it...?",
      "verdict": "pass",
      "note": "Accurate."
    },
    {
      "offset": "0x31cdbc",
      "back_en": "If... only I had... a little sooner...",
      "verdict": "pass",
      "note": "Accurate."
    },
    {
      "offset": "0x31cdeb",
      "back_en": "Haku... Haku...",
      "verdict": "pass",
      "note": "Accurate."
    },
    {
      "offset": "0x31cdfb",
      "back_en": "...Haku...",
      "verdict": "pass",
      "note": "Accurate."
    },
    {
      "offset": "0x31ce1a",
      "back_en": "Everyone's waiting for you.",
      "verdict": "pass",
      "note": "Accurate."
    },
    {
      "offset": "0x31abd7",
      "back_en": "A girl walking alone over the dark mountain",
      "verdict": "pass",
      "note": "Accurate."
    },
    {
      "offset": "0x31b258",
      "back_en": "fire burns voraciously, spreading and growing",
      "verdict": "pass",
      "note": "Accurate."
    },
    {
      "offset": "0x31b8c8",
      "back_en": "These shadows are lucky, in a way.",
      "verdict": "pass",
      "note": "Accurate."
    },
    {
      "offset": "0x31bf25",
      "back_en": "AAAAAARRGGHHH!!",
      "verdict": "pass",
      "note": "Scream variant, fine."
    },
    {
      "offset": "0x31bfb5",
      "back_en": "The girl stretches her arm vaguely toward the",
      "verdict": "pass",
      "note": "'blankly'→'vagamente' acceptable."
    },
    {
      "offset": "0x31c3c0",
      "back_en": "looking down at him, sitting atop a mound",
      "verdict": "pass",
      "note": "Accurate."
    },
    {
      "offset": "0x31c559",
      "back_en": "just to be killed.",
      "verdict": "pass",
      "note": "Accurate."
    },
    {
      "offset": "0x31c684",
      "back_en": "once again shrouded in silence.",
      "verdict": "pass",
      "note": "Accurate."
    },
    {
      "offset": "0x31c72e",
      "back_en": "in her path, as if waiting for her.",
      "verdict": "pass",
      "note": "Accurate."
    },
    {
      "offset": "0x31c7b4",
      "back_en": "The girl just keeps going forward, as if she",
      "verdict": "revise",
      "note": "'blindly' omitted; lost nuance."
    },
    {
      "offset": "0x31c85e",
      "back_en": "to her.",
      "verdict": "pass",
      "note": "Accurate."
    }
