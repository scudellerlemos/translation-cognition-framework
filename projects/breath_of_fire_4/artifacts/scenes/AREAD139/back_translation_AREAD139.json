    {
      "offset": "AREAD139.DAT:8:17",
      "back_en": "\"Well, we can't allow this, can we? This building belongs to the Fou Empire. And you are Easterners, aren't you?\"",
      "verdict": "pass",
      "note": "Accurate; minor 'permitir' for 'have' acceptable."
    },
    {
      "offset": "AREAD139.DAT:8:23",
      "back_en": "\"She was a very kind person--she said she was here on a goodwill visit to see people injured during the war. However...\"",
      "verdict": "pass",
      "note": "Faithful."
    },
    {
      "offset": "AREAD139.DAT:8:24",
      "back_en": "\"She is no longer with us.\"",
      "verdict": "pass",
      "note": "Correct."
    },
    {
      "offset": "AREAD139.DAT:8:25",
      "back_en": "\"Unfortunately it's the truth. So then!\"",
      "verdict": "pass",
      "note": "Accurate."
    },
    {
      "offset": "AREAD139.DAT:8:27",
      "back_en": "\"[04]! This place... Isn't it...?\" \"Yep...It's where we came looking for Elina before...\"",
      "verdict": "pass",
      "note": "Accurate."
    },
    {
      "offset": "AREAD139.DAT:8:39",
      "back_en": "\"You will not be able to cut that...Not with your mud.\"",
      "verdict": "revise",
      "note": "'lama' (mud) should be 'lâmina' (blade)."
    },
    {
      "offset": "AREAD139.DAT:8:40",
      "back_en": "\"E...Elina!?\"",
      "verdict": "pass",
      "note": "Matches."
    },
    {
      "offset": "AREAD139.DAT:8:42",
      "back_en": "\"[04]...[04]...!?\"",
      "verdict": "pass",
      "note": "Codes preserved."
    },
    {
      "offset": "AREAD139.DAT:8:46",
      "back_en": "\"The courtier named Yuna holds it. You must find him.\"",
      "verdict": "pass",
      "note": "Accurate."
    },
    {
      "offset": "AREAD139.DAT:8:14",
      "back_en": "\"Yes, Lord Yuna. At the present rate...\"",
      "verdict": "pass",
      "note": "Correct."
    },
    {
      "offset": "AREAD139.DAT:8:18",
      "back_en": "\"We're...looking for someone.\"",
      "verdict": "pass",
      "note": "Accurate."
    },
    {
      "offset": "AREAD139.DAT:8:28",
      "back_en": "\"Yep...It's where we came looking for Elina before...\"",
      "verdict": "pass",
      "note": "Accurate."
    },
    {
      "offset": "AREAD139.DAT:8:38",
      "back_en": "It's soft and rubbery... Maybe it could be cut with a sword or knife?",
