{
  "entries": [
    {
      "offset": "AREAS025.DAT:7:6",
      "back_en": "\"They say this ocean stretches to the Western continent.\"",
      "verdict": "pass",
      "note": "Accurate; capitalization of Ocidental fine."
    },
    {
      "offset": "AREAS025.DAT:7:15",
      "back_en": "\"Oops -- looks like your money is a little short.\"",
      "verdict": "pass",
      "note": "Meaning preserved; zenny rendered as 'dinheiro'."
    },
    {
      "offset": "AREAS025.DAT:7:24",
      "back_en": "\"All right, who am I to argue with the God of the Sea? You can come with us on the ship if you want!\"",
      "verdict": "pass",
      "note": "Faithful."
    },
    {
      "offset": "AREAS025.DAT:7:28",
      "back_en": "\"It's an old sailor's rule -- women bring bad luck!\"",
      "verdict": "pass",
      "note": "Idiomatic but preserves meaning."
    },
    {
      "offset": "AREAS025.DAT:7:43",
      "back_en": "\"Well... OK, OK, point to you. I can see you're strong indeed.\"",
      "verdict": "pass",
      "note": "Conveys same sense."
    },
    {
      "offset": "AREAS025.DAT:7:49",
      "back_en": "\"What? You still want to go through with it?\"",
      "verdict": "pass",
      "note": "Accurate."
    },
    {
      "offset": "AREAS025.DAT:7:58",
      "back_en": "\"All right then... Come with me.\"",
      "verdict": "pass",
      "note": "Accurate."
    },
    {
      "offset": "AREAS025.DAT:7:62",
      "back_en": "\"This sea stretches in all directions. There, at the edges, it becomes the Sea of Mud.\"",
      "verdict": "pass",
      "note": "Faithful."
    },
    {
      "offset": "AREAS025.DAT:7:64",
      "back_en": "\"Those girls are tougher than I thought! They lasted the whole night.\"",
      "verdict": "pass",
      "note": "Accurate."
    },
    {
      "offset": "AREAS025.DAT:7:139",
      "back_en": "Megaphone",
      "verdict": "pass",
      "note": "Correct translation."
    },
    {
      "offset": "AREAS025.DAT:7:140",
      "back_en": "SpiritBlast",
      "verdict": "pass",
      "note": "Skill name kept untranslated; consistent."
    }
  ],
  "reviewed": 11
}