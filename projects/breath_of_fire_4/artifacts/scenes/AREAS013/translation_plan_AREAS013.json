    {
      "offset": "AREAS013.DAT:8:19",
      "text_source": "[14][80]@\"Now that I've got[01]this,[02]I can make another[01][09][01][01] for[01]you!\"",
      "speaker": "npc",
      "tone_register": "satisfeito, promissor",
      "intent": "confirmar capacidade de cumprir tarefa",
      "risk_level": "medium",
      "base_translation": "[14][80]@\"Agora que tenho isso, posso [02]fazer outro para você!\"",
