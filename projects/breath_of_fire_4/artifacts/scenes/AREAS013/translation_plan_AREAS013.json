    {
      "offset": "AREAS013.DAT:8:22",
      "text_source": "[14][80]@\"Whew![0B] Well, what[01]do you think?[02]I told you it'd be[01]ready in a [05][02]jiffy[06]![02]Not a bad job, if I[01]say so myself! Here[01]you go!\"",
      "speaker": "npc",
      "tone_register": "satisfeito, orgulhoso, casual",
      "intent": "apresentar resultado com confiança",
      "risk_level": "low",
      "base_translation": "[14][80]@\"Ufa! Bem, o que acha? Te disse que ficaria pronto num [05][02]piscar[06]! Nada mal, se eu dizer assim! Toma!\"",
      "byte_budget": 174,
      "glossary_flags": [],
      "spoiler_flags": [],
      "risk_notes": ""
    },
    {
      "offset": "AREAS013.DAT:8:24",
      "text_source": "\"What!?[01]The [09][01][01],[01]a fake!?[02]Ho ho! Believe me,[01]it's real![02]I should know--after[01]all, I made it!\"",
      "speaker": "npc",
      "tone_register": "defensor, seguro, alegre",
      "intent": "refutar acusação e afirmar autoria",
      "risk_level": "medium",
      "base_translation": "\"O quê!? O [09], uma fraude[02]!? Ho ho! Acredita em mim, é real[02]! Eu deveria saber--afinal, eu fiz!\"",
      "byte_budget": 131,
      "glossary_flags": [],
      "spoiler_flags": [],
      "risk_notes": "token truncado [09][01][01]; referência ao objeto anterior esperada"
    },
    {
      "offset": "AREAS013.DAT:8:25",
      "text_source": "[14][02][01]\"Thank you very much,[01]sir.\"",
      "speaker": "unknown",
      "tone_register": "educado, formal",
      "intent": "agradecer um serviço",
      "risk_level": "low",
      "base_translation": "[14][02][01]\"Muito obrigado, senhor.\"",
      "byte_budget": 43,
      "glossary_flags": [],
      "spoiler_flags": [],
      "risk_notes": ""
    },
    {
      "offset": "AREAS013.DAT:8:28",
      "text_source": "[14][80]@\"Fine, suit yourself.[01]Come back if you[01]change your mind.\"",
      "speaker": "npc",
      "tone_register": "casual, indiferente",
      "intent": "aceitar recusa e convidar retorno",
      "risk_level": "low",
      "base_translation": "[14][80]@\"Tudo bem, como quiser. Volte se mudar de ideia.\"",
      "byte_budget": 85,
      "glossary_flags": [],
      "spoiler_flags": [],
      "risk_notes": ""
    },
    {
      "offset": "AREAS013.DAT:8:29",
      "text_source": "[14][80]@\"Ho...Looks like you[01]don't have enough[01]material...[02]Come back later when[01]you get some more.\"",
