      "risk_notes": "truncado no source ([09][01][01]); token de material incompleto"
    },
    {
      "offset": "AREAS013.DAT:8:20",
      "text_source": "[14][80]@\"You wait right[01]there![02]I'll have this done[01]in a jiffy!\"",
      "speaker": "npc",
      "tone_register": "entusiasmado, direto",
      "intent": "pedir paciência e antecipar resultado",
      "risk_level": "low",
