    "reinsert_script": "connector/reinsert.py",
    "encoding": "ascii_with_ctrl_codes_and_accent_overlays",
    "control_codes": {
      "01": "newline",
      "02": "page_break",
      "04": {"name": "var_char_name", "params": 1, "values": ["00", "01", "02", "03", "04", "05", "06"]},
      "05": {"name": "var_item_name", "params": 1, "values": ["01", "02", "03", "04", "05", "06", "07", "08", "0A", "0D"]},
      "07": {"name": "var_value", "params": 1, "values": ["00", "01", "02", "03", "04", "05", "06", "07", "08"]},
      "09": {"name": "unmapped", "params": 1},
      "0A": "voice_sfx",
      "0B": "pause",
      "0C": {"name": "event_cmd", "params": 1},
      "0F": {"name": "unmapped", "params": 1, "values": ["00", "01", "02", "03", "08", "09"]},
      "12": {"name": "choice_start", "params": 1},
      "14": {"name": "speaker_id", "params": 2},
      "16": {"name": "unmapped", "params": 1}
    },
    "space_strategy": "reconstrucao_secao",
    "patch_format": "full_file",
    "budget_reserves_terminator": true,
    "target_charset_supported": true,
    "charset_note": "Acento pt-BR = acento sobreposto + letra-base (2 bytes, igual ao UTF-8): connector/font.py estende a fonte de dialogo do INIT.DAT. Cobre a/e/o/u/c/i com agudo, grave, circunflexo, til e cedilha; outros diacriticos (n-til, trema) sao transliterados. Fonte de menu (16 px) ainda sem acento."
  },
  "db": {"path": "bof4.db", "project_id": "bof4"},
  "rag_min_score": 0.55,
  "profile": {
    "voice_profiles": "profile/voice_profiles_reference.md",
