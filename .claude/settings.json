{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "sonnet",
  "disableClaudeAiConnectors": true,
  "enabledPlugins": {
    "ponytail@ponytail": false,
    "linkedin-agent@synced": false
  },
  "deniedMcpServers": [
    {
      "serverName": "higgsfield"
    },
    {
      "serverName": "nano-banana"
    }
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/block_no_verify.py\" || exit 2",
            "shell": "bash"
          }
        ],
        "description": "Bloqueia git commit/push que pulam hooks/assinatura (falha fechado, Bash e PowerShell)"
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/content_guard.py\" || exit 2",
            "shell": "bash"
          }
        ],
        "description": "Bloqueia git add/commit/push com conteudo de jogo ou arquivo fora da allowlist no repo (falha fechado)"
      }
    ]
  },
  "skillOverrides": {
    "banner-design": "off",
    "built-in-browser": "off",
    "career-helper": "off",
    "chrome-browser": "off",
    "computer-use": "off",
    "deep-research": "off",
    "docs": "off",
    "docx": "off",
    "import-memory": "off",
    "letra-certa-quiz-episodio": "off",
    "morning": "off",
    "pdf": "off",
    "pptx": "off",
    "skill-creator": "off",
    "xlsx": "off"
  }
}
