{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/block_no_verify.py\" || exit 2",
            "shell": "bash"
          }
        ],
        "description": "Bloqueia git commit/push que pulam hooks/assinatura (falha fechado, Bash e PowerShell)"
      }
    ]
  }
}
